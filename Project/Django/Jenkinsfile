pipeline {
  agent {
    kubernetes {
      label 'kaniko-agent'
      defaultContainer 'kaniko'
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-kaniko-agent
spec:
  serviceAccountName: jenkins
  containers:
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command: ["/busybox/cat"]
      tty: true
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker
    - name: git
      image: alpine/git:2.45.2
      command: ["/bin/sh", "-c", "cat"]
      tty: true
  volumes:
    - name: docker-config
      emptyDir: {}
"""
    }
  }

  environment {
    AWS_REGION         = 'eu-north-1'
    ECR_REPOSITORY_URL = "${ECR_REPOSITORY_URL}"           // передається як Jenkins credential або параметр
    IMAGE_TAG          = "${env.BUILD_NUMBER}"
    GITOPS_REPO_URL    = 'https://github.com/Notalama/devops-cicd.git'
    GITOPS_VALUES_FILE = 'Project/charts/django-app/values.yaml'
    AWS_CREDENTIALS_ID = 'aws-jenkins-creds'
    GIT_CREDENTIALS_ID = 'git-token'
    DOCKER_CONTEXT     = 'Project/Django'
    DOCKERFILE_PATH    = 'Project/Django/Dockerfile'
  }

  options {
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build and Push to ECR') {
      steps {
        container('awscli') {
          sh '''
            set -eu
            ECR_HOST="${ECR_REPOSITORY_URL%%/*}"
            TOKEN=$(aws ecr get-login-password --region ${AWS_REGION})
            AUTH=$(printf "AWS:%s" "${TOKEN}" | base64 | tr -d "\\n")
            printf \'{"auths":{"%s":{"auth":"%s"}}}\' "${ECR_HOST}" "${AUTH}" > /kaniko/.docker/config.json
            echo "ECR auth config written"
          '''
        }
        container('kaniko') {
          sh '''
            set -eu
            /kaniko/executor \
              --context "${WORKSPACE}/${DOCKER_CONTEXT}" \
              --dockerfile "${WORKSPACE}/${DOCKERFILE_PATH}" \
              --destination "${ECR_REPOSITORY_URL}:${IMAGE_TAG}" \
              --destination "${ECR_REPOSITORY_URL}:latest" \
              --verbosity info
          '''
        }
      }
    }

    stage('Update Helm values in GitOps repo') {
      steps {
        container('git') {
          withCredentials([usernamePassword(credentialsId: "${GIT_CREDENTIALS_ID}", usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              set -eu
              rm -rf gitops
              git clone "https://${GIT_USER}:${GIT_TOKEN}@${GITOPS_REPO_URL#https://}" gitops
              cd gitops

              sed -i "s|^\\([[:space:]]*tag:[[:space:]]*\\).*|\\1\\"${IMAGE_TAG}\\"|g" "${GITOPS_VALUES_FILE}"

              git config user.email "jenkins@local"
              git config user.name "jenkins-bot"
              git add "${GITOPS_VALUES_FILE}"
              git commit -m "ci: update django image tag to ${IMAGE_TAG}" || true
              git push origin main
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "Build ${IMAGE_TAG} pushed to ECR and GitOps repo updated."
    }
    failure {
      echo "Pipeline failed - check logs above."
    }
  }
}
